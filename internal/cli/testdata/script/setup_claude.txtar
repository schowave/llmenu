# setup claude in accessible mode. Options in the slot lists, see stderr.
env LLMENU_ACCESSIBLE=1

# Enter everywhere: the suggestions for opus and sonnet stay unset, so they
# follow the gateway. haiku has no suggestion; Enter keeps it unset ("not set"
# is the first option), so nothing but the header is written.
stdin enter.txt
exec llmenu setup claude
stderr '^1\. aws/claude-opus-latest -> claude-opus-5-5  \(follows new versions\)$'
stderr '^1\. \(not set: Claude Code uses its built-in name'
stderr '^9\. azure/gpt-6-sol  ! not a Claude model$'
stderr 'Off: context grows up to the limit'
stderr 'show project and spend in the status line'
! stderr 'Warning'
cmp config.toml want-enter.toml

# Again Enter only: nothing changes.
stdin enter.txt
exec llmenu setup claude
! stderr 'Saved:'
cmp config.toml want-enter.toml

# Other answers are stored; a non-Claude model in a slot gives a warning.
stdin other.txt
exec llmenu setup claude
stderr '^Warning: azure/gpt-6-sol is not a Claude model; slot haiku runs e.g. subagents on it\.$'
cmp config.toml want-other.toml
exec llmenu claude
stdout '^claude args: --settings @settings --model gcp/claude-sonnet-4-5$'
stdout '^settings statusLine: llmenu statusline$'
stdout '^ANTHROPIC_DEFAULT_OPUS_MODEL=aws/claude-opus-5-5\[1m\]$'
stdout '^ANTHROPIC_DEFAULT_HAIKU_MODEL=azure/gpt-6-sol\[1m\]$'
stdout '^DISABLE_AUTO_COMPACTION=1$'

# A model name as default is offered after the slots and kept with Enter.
exec llmenu config set claude.default local/Qwen3-Next
stdin enter.txt
exec llmenu setup claude
stderr '(?s)Claude Code: default model.*\n4\. local/Qwen3-Next\nEnter a number between 1 and 4'
grep '^default = .local/Qwen3-Next.$' config.toml

# Back to the defaults: slot opus and compaction on are not pinned.
stdin defaults.txt
exec llmenu setup claude
! grep 'default =' config.toml
! grep 'auto_compact' config.toml
! grep 'statusline' config.toml

-- enter.txt --






-- other.txt --
2

9
2
n
y
-- defaults.txt --



1
y
n
-- want-enter.toml --
# Written by llmenu. Change with `llmenu setup` or `llmenu config set`;
# comments in this file are lost on the next write.

-- want-other.toml --
# Written by llmenu. Change with `llmenu setup` or `llmenu config set`;
# comments in this file are lost on the next write.

[claude]
default = 'sonnet'
opus = 'aws/claude-opus-5-5'
haiku = 'azure/gpt-6-sol'
auto_compact = false
statusline = true
