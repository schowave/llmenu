# setup tools in accessible mode: numbers toggle, 0 confirms. On PATH are the
# stand-ins for claude, codex and opencode; pi is not installed.
env LLMENU_ACCESSIBLE=1

# Without a choice, only Claude Code is preselected, whatever is installed.
stdin confirm.txt
exec llmenu setup tools
stderr '^1\. ✓ Claude Code'
stderr '^2\.   Codex CLI'
stderr '^4\.   pi .* - not installed$'
grep '^tools = \[.claude.\]$' config.toml

# claude off, opencode and pi on.
stdin toggle.txt
exec llmenu setup tools
grep '^tools = \[.opencode., .pi.\]$' config.toml

# The choice wins over installed tools; Enter keeps it.
stdin confirm.txt
exec llmenu setup tools
stderr '^1\.   Claude Code'
stderr '^4\. ✓ pi'
! stderr 'Saved:'

# Launchers of unused tools disappear from the help but keep working.
exec llmenu --help
stdout '^  opencode '
! stdout '^  claude '
! stdout '^  codex '
exec llmenu claude --model x
stdout '^claude args: --settings @settings --model x$'

# The claude section is skipped in a full setup when Claude Code is not used.
expandenv full.txt
stdin full.txt
exec llmenu setup
! stderr 'model for the "opus" slot'
# It asks for the default tool among the tools in use.
stderr 'What should `llmenu` without a command do\?'
grep '^launch = .opencode.$' config.toml

# Deselecting all is stored as a deliberate "none" ... and forgets the
# default tool.
stdin toggle-off.txt
exec llmenu setup tools
grep '^tools = \[\]$' config.toml
! grep '^launch' config.toml
! exec llmenu sync
stderr 'none of your tools keeps a model list'

# ... and kept by the next setup instead of preselecting Claude Code.
stdin confirm.txt
exec llmenu setup tools
! stderr '✓'
! stderr 'Saved:'

# A config file that cannot be written is reported.
[!windows] mkdir ro
[!windows] chmod 0500 ro
[!windows] env LLMENU_CONFIG=$WORK/ro/config.toml
[!windows] stdin confirm.txt
[!windows] ! exec llmenu setup tools
[!windows] stderr 'permission denied'

-- confirm.txt --
0
-- toggle.txt --
1
3
4
0
-- toggle-off.txt --
3
4
0
-- full.txt --
1
$LLMENU_BASE_URL


0


