exec llmenu secrets get gateway
stdout '^sk-test$'

! exec llmenu secrets get artificialanalysis
stderr 'key artificialanalysis not set'

! exec llmenu secrets get nope
stderr 'unknown key "nope"'

# Without a terminal the key is read from stdin, never from an argument.
stdin key.txt
exec llmenu secrets set artificialanalysis
! exec llmenu secrets set artificialanalysis extra-arg

stdin empty.txt
! exec llmenu secrets set artificialanalysis
stderr 'no key on stdin'

exec llmenu secrets delete artificialanalysis

-- key.txt --
aa-123
-- empty.txt --
