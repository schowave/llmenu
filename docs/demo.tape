# The README demo. Record with `mise run demo` (scripts/demo.sh sets up the
# fake gateway and environment first).
Output docs/demo.gif

Set Shell bash
Set FontSize 14
Set Width 1440
Set Height 620
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Hide
Type "export HOME=$LLMENU_DEMO_HOME PS1='\w $ '; cd $HOME/acme; clear"
Enter
Show

Type "llmenu default claude"
Sleep 400ms
Enter
Sleep 1.5s
Type "llmenu project use acme --here"
Sleep 400ms
Enter
Sleep 2s
Type "llmenu"
Sleep 400ms
Enter
Sleep 2s
Down
Sleep 800ms
Down
Sleep 800ms
Up
Up
Sleep 600ms
Tab
Sleep 1.2s
Tab
Sleep 1.2s
Tab
Sleep 1.2s
Tab
Sleep 600ms
Type "sonnet"
Sleep 1.5s
Enter
Sleep 3s
